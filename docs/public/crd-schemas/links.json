{
  "version": 1,
  "kinds": {
    "BatleHubLocalInstance": {
      "references": [
        {
          "path": "spec.configLayers[].configMapRef",
          "to": [
            {
              "group": "",
              "kind": "ConfigMap"
            }
          ]
        },
        {
          "path": "spec.configLayers[].secretRef",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        },
        {
          "path": "spec.external.adminTokenSecretRef",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        },
        {
          "path": "spec.external.tls.caSecretRef",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        },
        {
          "path": "spec.managed.credentials",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        },
        {
          "path": "spec.managed.operatorAccess.tokenSecretRef",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        }
      ],
      "produces": [
        {
          "kind": {
            "group": "schematic.weebo.io",
            "kind": "UpstreamRegistry"
          },
          "each": "spec.config.registries[].upstreams[]",
          "name": [
            "."
          ]
        },
        {
          "kind": {
            "group": "schematic.weebo.io",
            "kind": "DnsName"
          },
          "each": "spec.managed.ingress.extraHosts[]",
          "name": [
            "."
          ]
        },
        {
          "kind": {
            "group": "schematic.weebo.io",
            "kind": "DnsName"
          },
          "each": "spec.managed.ingress.host",
          "name": [
            "."
          ]
        }
      ]
    },
    "BatleHubMaintenance": {
      "references": [],
      "produces": []
    },
    "BatleHubNamespaceClaim": {
      "references": [],
      "produces": []
    },
    "BatleHubPackageGrant": {
      "references": [],
      "produces": []
    },
    "BatleHubPackagePolicy": {
      "references": [],
      "produces": []
    },
    "BatleHubRegistry": {
      "references": [
        {
          "path": "spec.configFrom[].configMapRef",
          "to": [
            {
              "group": "",
              "kind": "ConfigMap"
            }
          ]
        },
        {
          "path": "spec.configFrom[].secretRef",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        }
      ],
      "produces": [
        {
          "kind": {
            "group": "schematic.weebo.io",
            "kind": "UpstreamRegistry"
          },
          "each": "spec.config.upstreams[]",
          "name": [
            "."
          ]
        }
      ]
    },
    "Database": {
      "references": [],
      "produces": []
    },
    "DnsName": {
      "references": [],
      "produces": []
    },
    "HttpEndpoint": {
      "references": [],
      "produces": []
    },
    "OidcIssuer": {
      "references": [],
      "produces": []
    },
    "S3Bucket": {
      "references": [],
      "produces": []
    },
    "UpstreamRegistry": {
